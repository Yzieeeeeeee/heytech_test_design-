# ---------------------------------------------------------------------------
# Hey Tech Technologies — environment variables
# Copy this file to `.env.local` and fill in what you need.
# Nothing here is required to run the site: placeholders degrade gracefully.
# ---------------------------------------------------------------------------

# Public site URL — used for canonical URLs, sitemap, robots and OG metadata.
# Local dev:  http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# CONTACT FORM PROVIDER
# ---------------------------------------------------------------------------
# Options: none | formspree | resend | emailjs | supabase | firebase
# Leave as `none` (or unset) and the contact form will show an honest notice
# plus a pre-filled WhatsApp / email fallback. It will never fake a success.
NEXT_PUBLIC_FORM_PROVIDER=none

# Formspree — https://formspree.io  (public form id, safe to expose)
NEXT_PUBLIC_FORMSPREE_ID=

# EmailJS — https://emailjs.com  (all three values are public/client-side)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# Resend — https://resend.com  (SERVER ONLY, never prefix with NEXT_PUBLIC_)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Supabase — https://supabase.com  (server-side insert adapter)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: privacy-friendly analytics, off by default.
NEXT_PUBLIC_ENABLE_ANALYTICS=false
